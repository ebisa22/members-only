<!DOCTYPE html>
<html lang="en">
 <%- include('partials/head', { title: 'Sign Up', cssPath: 'signup.css' }) %>
<body>
<%- include('partials/navbar') %>

<main class="signup-page">
    <div class="signup-container">
        <div class="signup-heading">
            <span class="signup-eyebrow">BECOME PART OF THE COMMUNITY</span>
            <h1>Create your account<span>.</span></h1>
            <p>Join the conversation. It starts with you.</p>
        </div>

        <form action="/signup" method="POST" class="signup-form">
            <div class="form-row">
                <div class="form-group">
                    <label for="first_name">First name</label>
                    <input
                        type="text"
                        id="first_name"
                        name="first_name"
                        placeholder="Your first name"
                        value="<%= formData?.first_name || '' %>"
                        required
                    >
                    <% if (errors?.first_name) { %>
                        <small class="field-error"><%= errors.first_name.msg %></small>
                    <% } %>
                </div>

                <div class="form-group">
                    <label for="last_name">Last name</label>
                    <input
                        type="text"
                        id="last_name"
                        name="last_name"
                        placeholder="Your last name"
                        value="<%= formData?.last_name || '' %>"
                        required
                    >
                    <% if (errors?.last_name) { %>
                        <small class="field-error"><%= errors.last_name.msg %></small>
                    <% } %>
                </div>
            </div>

            <div class="form-group">
                <label for="username">Email address</label>
                <input
                    type="email"
                    id="username"
                    name="username"
                    placeholder="you@example.com"
                    value="<%= formData?.username || '' %>"
                    required
                >
                <% if (errors?.username) { %>
                    <small class="field-error"><%= errors.username.msg %></small>
                <% } %>
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <input
                    type="password"
                    id="password"
                    name="password"
                    placeholder="Create a password"
                    required
                >
                <% if (errors?.password) { %>
                    <small class="field-error"><%= errors.password.msg %></small>
                <% } %>
            </div>

            <div class="form-group">
                <label for="confirmPassword">Confirm password</label>
                <input
                    type="password"
                    id="confirmPassword"
                    name="confirmPassword"
                    placeholder="Enter your password again"
                    required
                >
                <% if (errors?.confirmPassword) { %>
                    <small class="field-error"><%= errors.confirmPassword.msg %></small>
                <% } %>
            </div>

            <div class="form-divider">
                <span>ACCOUNT RECOVERY</span>
            </div>

            <div class="form-group">
                <label for="security_question">Security question</label>
                <select id="security_question" name="security_question" required>
                    <option value="" disabled <%= !formData?.security_question ? 'selected' : '' %>>
                        Choose a security question
                    </option>
                    <% securityQuestions.forEach(question => { %>
                        <option
                            value="<%= question %>"
                            <%= formData?.security_question === question ? 'selected' : '' %>
                        >
                            <%= question %>
                        </option>
                    <% }) %>
                </select>
                <% if (errors?.security_question) { %>
                    <small class="field-error"><%= errors.security_question.msg %></small>
                <% } %>
            </div>

            <div class="form-group">
                <label for="security_answer">Your answer</label>
                <input
                    type="text"
                    id="security_answer"
                    name="security_answer"
                    placeholder="Enter your answer"
                    required
                >
                <% if (errors?.security_answer) { %>
                    <small class="field-error"><%= errors.security_answer.msg %></small>
                <% } %>
            </div>

            <button type="submit" class="signup-submit">
                Create account <span>&rarr;</span>
            </button>

            <p class="login-prompt">
                Already have an account?
                <a href="/login">Log in</a>
            </p>
        </form>
    </div>
</main>

<%- include('partials/footer') %>

</body>
</html>
