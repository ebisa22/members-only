
<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { title: 'Server Error', cssPath: 'error.css' }) %>
<body>
    <%- include('../partials/navbar') %>

    <main class="error-page">
        <section class="error-content">
            <span class="error-code">500</span>
            <span class="error-eyebrow">INTERNAL SERVER ERROR</span>

            <h1>Something went wrong.</h1>

            <p>
                We encountered an unexpected problem while processing
                your request. Please try again in a moment.
            </p>

            <div class="error-actions">
                <a href="/messages" class="primary-btn">Back to messages</a>
                <button type="button" class="secondary-btn" onclick="history.back()">
                    Go back
                </button>
            </div>
        </section>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>
