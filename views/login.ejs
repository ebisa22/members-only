<!DOCTYPE html>
<html lang="en">
 <%- include('partials/head', { title: 'Log In', cssPath: 'login.css' }) %>
<body>
<%- include('partials/navbar') %>

<main class="login-page">
    <div class="login-container">
        <div class="login-heading">
            <span class="login-eyebrow">WELCOME BACK</span>
            <h1>Good to see you<span>.</span></h1>
            <p>Log in to continue the conversation.</p>
        </div>

        <form action="/login" method="POST" class="login-form">
            <% if (errorMessage) { %>
                <div class="login-error" role="alert">
                    <%= errorMessage %>
                </div>
            <% } %>

            <div class="form-group">
                <label for="username">Email address</label>
                <input
                    type="email"
                    id="username"
                    name="username"
                    placeholder="you@example.com"
                    value="<%= formData?.username || '' %>"
                    required
                >
                <% if (errors?.username) { %>
                    <small class="field-error"><%= errors.username.msg %></small>
                <% } %>
            </div>

            <div class="form-group">
                <div class="password-label">
                    <label for="password">Password</label>
                    <a href="/forgot-password">Forgot password?</a>
                </div>

                <input
                    type="password"
                    id="password"
                    name="password"
                    placeholder="Enter your password"
                    required
                >
                <% if (errors?.password) { %>
                    <small class="field-error"><%= errors.password.msg %></small>
                <% } %>
            </div>

            <button type="submit" class="login-submit">
                Log in <span>&rarr;</span>
            </button>

            <p class="signup-prompt">
                Don't have an account?
                <a href="/signup">Create an account</a>
            </p>
        </form>
    </div>
</main>

<%- include('partials/footer') %>

</body>
</html>
